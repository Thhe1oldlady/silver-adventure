# Environment Configuration Example
# Copy this file to .env and configure your settings

# Application Settings
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here
API_VERSION=v1

# Database Configuration
DATABASE_URL=sqlite:///./silver_adventure.db
DATABASE_ECHO=false

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@silver-adventure.com

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/silver_adventure.log

# Model Configuration
MODEL_PATH=models/
DATA_PATH=data/
ENABLE_MODEL_TRAINING=true

# Security Settings
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# Performance Settings
WORKERS=1
MAX_REQUESTS=1000
TIMEOUT=30

# Feature Flags
ENABLE_EMAIL_SENDING=true
ENABLE_CHURN_PREDICTION=true
ENABLE_GOLDEN_MOOD_TEMPLATES=true
ENABLE_ANALYTICS=true

# External Services
ANALYTICS_API_KEY=your-analytics-key
MONITORING_SERVICE_URL=http://localhost:9090

# PyPy Configuration
PYPY_ENABLED=false
PYPY_PATH=/usr/local/bin/pypy3

# Development Settings
RELOAD=true
HOST=0.0.0.0
PORT=8000